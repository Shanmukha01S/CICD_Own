
pipeline {
    agent any

environment{
 
WL_USER="weblogic"
WL_PASSWORD="Shan@1998"
WL_URL="t3://localhost:7001"
WL_NM="MS1,MS2"

}
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build WAR') {
            steps {
                // Runs the Maven command we tested earlier
                sh 'mvn clean package'
            }
        }
        
        stage('Archive Artifact') {
            steps {
                // Saves the .war file in Jenkins for later use
                archiveArtifacts artifacts: 'target/*.war', followSymlinks: false
        

          stage('Deploy to weblogic'){
          steps{
            echo "Deploying to weblogic @${WL_URL}....."
             
             sh """

             java weblogic.deployer -adminurl ${WL_URL} \
              -user ${WL_USER} -password ${WL_PASSWORD} \
              -deploy -name practice-app \
              -source target/pratice-app.war \
              -targets ms1,ms2

                  """

            }
        }
    }
}


